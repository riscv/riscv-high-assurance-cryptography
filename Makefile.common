#
# SPDX-License-Identifier: CC-BY-SA-4.0
#

DATE ?= $(shell date +%Y-%m-%d)
DOCKER_BIN ?= docker

# ARC_NAMING=yes (the default) derives the version and lifecycle phase from the
# git tag via scripts/release-info.sh and names each PDF per ARC_SUBMISSION.md:
# <spec-short>-v<version>-<YYYYMMDD>.pdf. A stub building a document that is not
# an ARC deliverable (the whitepaper) sets ARC_NAMING := no, a fixed VERSION and
# optionally REVMARK, and keeps the plain build/<basename>.pdf name.
ARC_NAMING ?= yes

ifeq ($(ARC_NAMING),yes)
# Version identity comes from the tag: vX.YY on a tagged commit, otherwise
# <latest>-<sha>. Override with `make VERSION=vX.YY` for a release build.
VERSION ?= $(shell ./scripts/release-info.sh version)
PHASE ?= $(shell ./scripts/release-info.sh phase "$(VERSION)")
PHASE_DISPLAY ?= $(shell ./scripts/release-info.sh display "$(VERSION)")
PHASE_NOTICE ?= $(shell ./scripts/release-info.sh notice "$(VERSION)")
REVMARK ?= $(shell ./scripts/release-info.sh revremark "$(VERSION)")
MILESTONE_ID ?= $(PHASE)
PHASE_OPTS := -a phase='$(PHASE)' \
              -a phase_display='$(PHASE_DISPLAY)' \
              -a phase_notice='$(PHASE_NOTICE)' \
              -a milestone_id='$(MILESTONE_ID)'
else
REVMARK ?= Draft
PHASE_OPTS :=
endif

# The spec short name is the assembler's basename, which is what names the PDF.
SPEC_SHORT ?= $(basename $(firstword $(DOCS)))
DATE_STAMP := $(subst -,,$(DATE))
VERSION_NUM := $(patsubst v%,%,$(VERSION))

# ARC-compliant PDF name for a document basename.
ARC_PDF = $(1)-v$(VERSION_NUM)-$(DATE_STAMP).pdf

# Only a build of a clean vX.YY (a tag, or an explicit VERSION=) is submittable;
# an untagged build carries -<sha> in its version and is a development artifact.
ARC_EXACT := $(if $(findstring -,$(VERSION)),,yes)

SRC_DIR := src
BUILD_DIR := build

XTRA_ADOC_OPTS ?=
ASCIIDOCTOR_PDF := asciidoctor-pdf
#ASCIIDOCTOR_PDF :=  /Users/mocenigo/.rbenv/shims/asciidoctor-pdf
ASCIIDOCTOR_HTML := asciidoctor

# The stub that was actually invoked -- MAKEFILE_LIST starts with the makefile
# make was pointed at, and this file is only ever appended to it.
THIS_MAKEFILE := $(firstword $(MAKEFILE_LIST))

ifneq ($(SKIP_DOCKER),true)
	DOCKER_IS_PODMAN = \
		$(shell ! ${DOCKER_BIN} -v 2>&1 | grep podman >/dev/null ; echo $$?)
	ifeq "$(DOCKER_IS_PODMAN)" "1"
		DOCKER_VOL_SUFFIX = :z
	endif

	DOCKER_CMD := \
		${DOCKER_BIN} run --rm \
			-v "${PWD}:/build${DOCKER_VOL_SUFFIX}" \
			-w /build \
			${DOCKER_IMG} \
			/bin/sh -c
	DOCKER_QUOTE := "
endif

ifeq ($(ARC_NAMING),yes)
DOCS_PDF := $(foreach d,$(DOCS:%.adoc=%),$(BUILD_DIR)/$(call ARC_PDF,$(d)))
else
DOCS_PDF := $(DOCS:%.adoc=$(BUILD_DIR)/%.pdf)
endif
DOCS_HTML := $(DOCS:%.adoc=$(BUILD_DIR)/%.html)

BUILD_DOCS ?= $(DOCS_PDF) $(DOCS_HTML)

# Built only on demand, by `make encodings`, from src/encodings.adoc.
ENCODINGS_DOCS := $(BUILD_DIR)/encodings.pdf $(BUILD_DIR)/encodings.html

DOC_DEPS := $(wildcard $(SRC_DIR)/*.adoc) \
            $(wildcard $(SRC_DIR)/*.bib) \
            $(wildcard $(SRC_DIR)/*.rb) \
            $(wildcard $(SRC_DIR)/*.yml) \
            $(wildcard $(SRC_DIR)/images/*) \
            $(wildcard docs-resources/*.adoc) \
            $(wildcard docs-resources/themes/*.yml)

OPTIONS := --trace \
           -v \
           -a compress \
           -a allow-uri-read \
           -a mathematical-format=svg \
           -a revnumber='$(VERSION)' \
           -a revremark='$(REVMARK)' \
           -a revdate='$(DATE)' \
           $(PHASE_OPTS) \
           -a spec_short='$(SPEC_SHORT)' \
           -a pdf-fontsdir=docs-resources/fonts \
           -a pdf-theme=$(PDF_THEME) \
           $(XTRA_ADOC_OPTS) \
           -D $(BUILD_DIR) \
           --failure-level=ERROR

.PHONY: all build clean build-container build-no-container build-docs \
        build-pdf build-html encodings update-docs-resources

all: build

build-docs: $(BUILD_DOCS)

build-pdf: $(DOCS_PDF)

build-html: $(DOCS_HTML)

# Goes through `build`, so the Docker check applies as for the main document;
# the BUILD_DOCS override reaches the nested makes through MAKEFLAGS.
encodings:
	$(MAKE) -f $(THIS_MAKEFILE) BUILD_DOCS="$(ENCODINGS_DOCS)" build

vpath %.adoc $(SRC_DIR)

# asciidoctor creates the output directory itself (see -D in OPTIONS).
$(BUILD_DIR)/%.pdf: %.adoc
	$(DOCKER_CMD) $(DOCKER_QUOTE) $(ASCIIDOCTOR_PDF) $(OPTIONS) $(REQUIRES) $< $(DOCKER_QUOTE)

# ARC-named PDF. asciidoctor writes the final name itself (-o resolves relative
# to -D): renaming afterwards fails with EPERM on rootful Docker, where build/
# is owned by root. For build/<doc>-v<ver>-<date>.pdf make prefers this rule
# over the plain one above, as its stem is shorter.
$(BUILD_DIR)/%-v$(VERSION_NUM)-$(DATE_STAMP).pdf: %.adoc
	$(DOCKER_CMD) $(DOCKER_QUOTE) $(ASCIIDOCTOR_PDF) $(OPTIONS) $(REQUIRES) -o $(notdir $@) $< $(DOCKER_QUOTE)
	@test -f $@ || { echo "ERROR: $@ was not produced" >&2; exit 1; }
	@if [ -n "$(ARC_EXACT)" ]; then \
		echo "ARC submission PDF: $@"; \
	else \
		echo "Development PDF: $@"; \
		echo "  Built from an untagged commit ($(VERSION)) -- NOT an ARC submission artifact."; \
		echo "  Build from a v* tag, or run 'make VERSION=vX.YY', to produce one."; \
	fi

$(BUILD_DIR)/%.html: %.adoc
	$(DOCKER_CMD) $(DOCKER_QUOTE) $(ASCIIDOCTOR_HTML) $(OPTIONS) $(REQUIRES) $< $(DOCKER_QUOTE)

$(DOCS_PDF) $(DOCS_HTML) $(ENCODINGS_DOCS): $(DOC_DEPS) *.adoc src/*.adoc

ifeq ($(SKIP_DOCKER),true)

build: build-no-container

else

.PHONY: docker-pull-latest

build:
	@echo "Checking if Docker is available..."
	@if command -v ${DOCKER_BIN} >/dev/null 2>&1 ; then \
		echo "Docker is available, building inside Docker container..."; \
		$(MAKE) -f $(THIS_MAKEFILE) build-container; \
	else \
		echo "Docker is not available, building without Docker..."; \
		$(MAKE) -f $(THIS_MAKEFILE) build-no-container; \
	fi

# Update docker image to latest
docker-pull-latest:
	${DOCKER_BIN} pull ${DOCKER_IMG}

endif

build-container:
	@echo "Starting build inside Docker container..."
	$(MAKE) -f $(THIS_MAKEFILE) build-docs
	@echo "Build completed successfully inside Docker container."

build-no-container:
	@echo "Starting build..."
	$(MAKE) -f $(THIS_MAKEFILE) SKIP_DOCKER=true build-docs
	@echo "Build completed successfully."

clean:
	@echo "Cleaning up generated files..."
	rm -rf $(BUILD_DIR)
	@echo "Cleanup completed."

update-docs-resources:
	git submodule update --force --recursive --init --remote
