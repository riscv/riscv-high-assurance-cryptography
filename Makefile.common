#

DATE ?= $(shell date +%Y-%m-%d)
REVMARK ?= Draft
DOCKER_BIN ?= docker

SRC_DIR := src
BUILD_DIR := build

XTRA_ADOC_OPTS ?=
ASCIIDOCTOR_PDF := asciidoctor-pdf
ASCIIDOCTOR_HTML := asciidoctor

# The stub that was actually invoked -- MAKEFILE_LIST starts with the makefile
# make was pointed at, and this file is only ever appended to it.
THIS_MAKEFILE := $(firstword $(MAKEFILE_LIST))

ifneq ($(SKIP_DOCKER),true)
	DOCKER_IS_PODMAN = \
		$(shell ! ${DOCKER_BIN} -v 2>&1 | grep podman >/dev/null ; echo $$?)
	ifeq "$(DOCKER_IS_PODMAN)" "1"
		DOCKER_VOL_SUFFIX = :z
	endif

	DOCKER_CMD := \
		${DOCKER_BIN} run --rm \
			-v "${PWD}:/build${DOCKER_VOL_SUFFIX}" \
			-w /build \
			${DOCKER_IMG} \
			/bin/sh -c
	DOCKER_QUOTE := "
endif

DOCS_PDF := $(DOCS:%.adoc=$(BUILD_DIR)/%.pdf)
DOCS_HTML := $(DOCS:%.adoc=$(BUILD_DIR)/%.html)

BUILD_DOCS ?= $(DOCS_PDF) $(DOCS_HTML)

OPTIONS := --trace \
           -v \
           -a compress \
           -a mathematical-format=svg \
           -a revnumber=${VERSION} \
           -a revremark=${REVMARK} \
           -a revdate=${DATE} \
           -a pdf-fontsdir=docs-resources/fonts \
           -a pdf-theme=$(PDF_THEME) \
           $(XTRA_ADOC_OPTS) \
           -D $(BUILD_DIR) \
           --failure-level=ERROR

.PHONY: all build clean build-container build-no-container build-docs \
        build-pdf build-html update-docs-resources

all: build

build-docs: $(BUILD_DOCS)

build-pdf: $(DOCS_PDF)

build-html: $(DOCS_HTML)

vpath %.adoc $(SRC_DIR)

# asciidoctor creates the output directory itself (see -D in OPTIONS).
$(BUILD_DIR)/%.pdf: %.adoc
	$(DOCKER_CMD) $(DOCKER_QUOTE) $(ASCIIDOCTOR_PDF) $(OPTIONS) $(REQUIRES) $< $(DOCKER_QUOTE)

$(BUILD_DIR)/%.html: %.adoc
	$(DOCKER_CMD) $(DOCKER_QUOTE) $(ASCIIDOCTOR_HTML) $(OPTIONS) $(REQUIRES) $< $(DOCKER_QUOTE)

$(DOCS_PDF): $(SRC_DIR)/*.adoc

ifeq ($(SKIP_DOCKER),true)

build: build-no-container

else

.PHONY: docker-pull-latest

build:
	@echo "Checking if Docker is available..."
	@if command -v ${DOCKER_BIN} >/dev/null 2>&1 ; then \
		echo "Docker is available, building inside Docker container..."; \
		$(MAKE) -f $(THIS_MAKEFILE) build-container; \
	else \
		echo "Docker is not available, building without Docker..."; \
		$(MAKE) -f $(THIS_MAKEFILE) build-no-container; \
	fi

# Update docker image to latest
docker-pull-latest:
	${DOCKER_BIN} pull ${DOCKER_IMG}

endif

build-container:
	@echo "Starting build inside Docker container..."
	$(MAKE) -f $(THIS_MAKEFILE) build-docs
	@echo "Build completed successfully inside Docker container."

build-no-container:
	@echo "Starting build..."
	$(MAKE) -f $(THIS_MAKEFILE) SKIP_DOCKER=true build-docs
	@echo "Build completed successfully."

clean:
	@echo "Cleaning up generated files..."
	rm -rf $(BUILD_DIR)
	@echo "Cleanup completed."

update-docs-resources:
	git submodule update --force --recursive --init --remote
