# Build the ACE specification with a natively installed asciidoctor.
#
# SPDX-License-Identifier: CC-BY-SA-4.0

DOCS      := ace.adoc
VERSION   ?= v0.6.0
PDF_THEME := src/riscv-pdf.yml
# asciidoctor-mathematical is deliberately left out: the gem is awkward to
# install natively, and the container variants cover the math builds.
REQUIRES  := --require=asciidoctor-bibtex \
             --require=asciidoctor-diagram \
             --require=asciidoctor-lists \
             --require=asciidoctor-sail

SKIP_DOCKER := true

# The HTML is built on demand with `make -f Makefile.local build-html`.
BUILD_DOCS = $(DOCS_PDF)

RUBYOPT ?= --zjit
export RUBYOPT

include Makefile.common
