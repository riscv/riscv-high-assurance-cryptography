# Build the ACE whitepaper with a natively installed asciidoctor.
#
# SPDX-License-Identifier: CC-BY-SA-4.0

DOCS      := ace-whitepaper.adoc
VERSION   ?= v0.2.0
PDF_THEME := src/wp.yml
REQUIRES  := --require=asciidoctor-lists \
             --require=asciidoctor-bibtex

SKIP_DOCKER := true

# The HTML is built on demand with `make -f Makefile.wplocal build-html`.
BUILD_DOCS = $(DOCS_PDF)

RUBYOPT ?= --zjit
export RUBYOPT

include Makefile.common
