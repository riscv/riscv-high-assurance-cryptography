# Build the KLEE whitepaper in the docs container, via the Qualcomm registry.
#
# SPDX-License-Identifier: CC-BY-SA-4.0

DOCS      := klee-whitepaper.adoc
VERSION   ?= v0.2.0
# Not an ARC deliverable: fixed version, plain build/<basename>.pdf name.
ARC_NAMING := no
PDF_THEME := src/wp.yml
REQUIRES  := --require=asciidoctor-lists \
             --require=asciidoctor-bibtex

DOCKER_IMG := docker-registry.qualcomm.com/proxy-cache-qcom/riscvintl/riscv-docs-base-container-image:latest

include Makefile.common
